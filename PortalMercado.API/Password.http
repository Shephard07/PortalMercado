@baseUrl = https://localhost:7161
# Preparar cookies y CSRF mediante /api/auth/csrf. Tras login/MFA, renovar CSRF.
# Sustituir los marcadores solo en el cliente local; no versionar valores reales.
@csrf = CSRF_TEMPORAL

### Solicitar recuperación (correo local en Development)
POST {{baseUrl}}/api/auth/forgot-password
X-CSRF-TOKEN: {{csrf}}
Content-Type: application/json

{"correo":"vendedor.et02@example.invalid"}

### Restablecer usando el enlace recibido por correo
POST {{baseUrl}}/api/auth/reset-password
X-CSRF-TOKEN: {{csrf}}
Content-Type: application/json

{
  "token":"TOKEN_TEMPORAL_DEL_CORREO",
  "newPassword":"REEMPLAZAR_EN_CLIENTE_LOCAL",
  "confirmPassword":"REEMPLAZAR_EN_CLIENTE_LOCAL"
}

### Cambiar contraseña de la sesión actual (requiere login/MFA)
POST {{baseUrl}}/api/auth/change-password
X-CSRF-TOKEN: {{csrf}}
Content-Type: application/json

{
  "currentPassword":"REEMPLAZAR_EN_CLIENTE_LOCAL",
  "newPassword":"REEMPLAZAR_EN_CLIENTE_LOCAL",
  "confirmPassword":"REEMPLAZAR_EN_CLIENTE_LOCAL"
}
