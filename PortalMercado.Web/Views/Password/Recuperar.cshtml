@model PortalMercado.Application.Security.ForgotPasswordRequest
@{ ViewData["Title"] = "Recuperar contraseña"; }
<div class="col-md-7 col-lg-5 mx-auto py-4"><h1 class="h3">Recuperar contraseña</h1>
<p>Escribe el correo de tu cuenta para solicitar instrucciones de recuperación.</p>
<form method="post" asp-controller="Password" asp-action="Recuperar">
<div asp-validation-summary="All" class="text-danger" role="alert"></div>
<label asp-for="Correo" class="form-label">Correo electrónico</label><input asp-for="Correo" type="email" autocomplete="username" required maxlength="254" class="form-control mb-3" />
<button class="btn btn-primary">Solicitar enlace</button></form>
<a class="d-block mt-3" asp-controller="Cuenta" asp-action="Login">Volver al inicio de sesión</a></div>
