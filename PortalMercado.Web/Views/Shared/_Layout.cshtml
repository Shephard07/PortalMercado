@{
    var controlador = ViewContext.RouteData.Values["controller"]?.ToString();
    var accion = ViewContext.RouteData.Values["action"]?.ToString();
    var autenticado = User.Identity?.IsAuthenticated == true;
    var accesos = MenuPrincipal.Crear(User);
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · PortalMercado</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/menu-principal.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/clientes-demostracion.css" asp-append-version="true" />
</head>
<body class="@(autenticado ? "pm-administracion" : "pm-visitante")">
    <a class="pm-skip visually-hidden-focusable" href="#contenido">Saltar al contenido</a>
    <header class="pm-header pm-barra-principal">
        <div class="pm-barra-interior">
            @if (autenticado)
            {
                <button class="pm-menu-toggle btn btn-outline-secondary" type="button" data-bs-toggle="collapse"
                        data-bs-target="#menu-lateral" aria-controls="menu-lateral" aria-expanded="false" aria-label="Abrir o cerrar el menú">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M3 6h18M3 12h18M3 18h18" /></svg>
                    <span>Menú</span>
                </button>
            }
            <a class="pm-brand pm-marca-panel" asp-controller="Home" asp-action="Index">
                <span class="pm-brand-mark" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 10v10h16V10M3 10l2-6h14l2 6M3 10a3 3 0 0 0 4.5 2.6A3 3 0 0 0 12 10a3 3 0 0 0 4.5 2.6A3 3 0 0 0 21 10M9 20v-5h6v5M8 4l-1 6m9-6 1 6" /></svg>
                </span>
                <span>Portal<span class="pm-marca-naranja">Mercado</span></span>
            </a>
            @if (autenticado)
            {
                <form class="pm-buscar-modulo" asp-controller="Home" asp-action="Index" method="get" role="search">
                    <label for="buscar-modulo" class="visually-hidden">Buscar un módulo disponible</label>
                    <input id="buscar-modulo" name="q" value="@(controlador == "Home" ? Context.Request.Query["q"].ToString() : null)"
                           maxlength="80" placeholder="Buscar un módulo…" type="search" />
                    <button type="submit">Buscar</button>
                </form>
            }
            <nav class="pm-barra-accesos" aria-label="Accesos generales">
                <a asp-controller="Tiendas" asp-action="Directorio">Tiendas</a>
                @if (autenticado)
                {
                    <a class="pm-cuenta-panel" asp-controller="Cuenta" asp-action="Perfil" title="Mi perfil">@(User.Identity?.Name)</a>
                }
                else
                {
                    <a class="btn btn-outline-primary" asp-controller="Cuenta" asp-action="Login">Iniciar sesión</a>
                }
            </nav>
        </div>
    </header>
    <div class="@(autenticado ? "pm-estructura-panel" : "pm-estructura-publica")">
        @if (autenticado)
        {
            <aside id="menu-lateral" class="pm-menu-lateral collapse">
                <nav aria-label="Menú de trabajo">
                    @foreach (var grupo in accesos.GroupBy(a => a.Grupo))
                    {
                        <p class="pm-menu-grupo">@grupo.Key</p>
                        @foreach (var acceso in grupo)
                        {
                            var activo = acceso.Activo(controlador, accion);
                            <a class="pm-menu-enlace @(activo ? "active" : null)" aria-current="@(activo ? "page" : null)"
                               asp-controller="@acceso.Controlador" asp-action="@acceso.Accion">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="@acceso.Icono" /></svg>
                                <span>@acceso.Nombre</span>
                            </a>
                        }
                    }
                </nav>
                <div class="pm-menu-ayuda"><strong>Tu mercado, más cerca</strong><p>Consulta el directorio de tiendas y sus productos.</p>
                    <a asp-controller="Tiendas" asp-action="Directorio">Explorar tiendas →</a>
                </div>
                <form asp-controller="Cuenta" asp-action="Logout" method="post" class="pm-salir-panel">
                    <button class="btn btn-outline-secondary" type="submit">Cerrar sesión</button>
                </form>
            </aside>
        }
        <main id="contenido" class="@(autenticado ? "pm-contenido-panel" : "pm-container pm-main")" tabindex="-1">
            @await Html.PartialAsync("_AvisoClientesDemostracion")
            @RenderBody()
        </main>
    </div>
    <footer class="pm-footer"><div class="pm-container pm-footer-inner"><span>© 2026 PortalMercado</span>
        <a asp-controller="Home" asp-action="Privacy">Privacidad</a></div></footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/menu-principal.js" asp-append-version="true" defer></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
