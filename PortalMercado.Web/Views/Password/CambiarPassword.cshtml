@model PortalMercado.Application.Security.ChangePasswordRequest
@{ ViewData["Title"] = "Cambiar contraseña"; }
<div class="col-md-7 col-lg-5 mx-auto py-4"><h1 class="h3">Cambiar contraseña</h1>
<p>Usa entre 12 y 128 caracteres, con mayúscula, minúscula, número y símbolo. Al guardar se cerrarán tus sesiones y tendrás que iniciar sesión nuevamente.</p>
<form method="post" asp-controller="Password" asp-action="CambiarPassword">
<div asp-validation-summary="All" class="text-danger" role="alert"></div>
<label for="CurrentPassword" class="form-label">Contraseña actual</label><input type="password" id="CurrentPassword" name="CurrentPassword" autocomplete="current-password" required maxlength="128" class="form-control mb-3" />
<label for="NewPassword" class="form-label">Nueva contraseña</label><input type="password" id="NewPassword" name="NewPassword" autocomplete="new-password" required minlength="12" maxlength="128" class="form-control mb-3" />
<label for="ConfirmPassword" class="form-label">Repetir nueva contraseña</label><input type="password" id="ConfirmPassword" name="ConfirmPassword" autocomplete="new-password" required minlength="12" maxlength="128" class="form-control mb-3" />
<button class="btn btn-primary">Cambiar contraseña</button></form><a class="d-block mt-3" asp-controller="Cuenta" asp-action="Perfil">Volver a mi perfil</a></div>
