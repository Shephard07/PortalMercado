@model PortalMercado.Application.Security.MfaEnrollment
@{ ViewData["Title"] = "Configurar verificación en dos pasos"; }
<div class="row justify-content-center"><div class="col-md-7 col-lg-6">
    <h1 class="h3">Configura la verificación en dos pasos</h1>
    <p>En tu aplicación de autenticación, agrega una cuenta con clave de configuración y códigos basados en tiempo.</p>
    <dl>
        <dt>Nombre de la cuenta</dt><dd>PortalMercado</dd>
        <dt>Clave de configuración</dt><dd class="font-monospace user-select-all border rounded p-3 text-break">@Model.Secret</dd>
    </dl>
    <p>Escribe el código de seis dígitos que aparece en la aplicación. Esta clave es privada; consérvala solo en tu aplicación.</p>
    <form asp-action="ConfirmarMfa" method="post">
        <div asp-validation-summary="All" class="text-danger" role="alert"></div>
        <label for="Code" class="form-label">Código de verificación</label>
        <input name="Code" id="Code" class="form-control mb-3" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9]{6}" maxlength="6" required />
        <button class="btn btn-primary" type="submit">Confirmar y activar mi cuenta</button>
    </form>
    <a class="d-block mt-3" asp-action="Login">Volver al inicio de sesión</a>
</div></div>
